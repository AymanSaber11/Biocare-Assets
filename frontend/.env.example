# Frontend Configuration
VITE_APP_NAME=Biocare Assets CMMS
VITE_APP_VERSION=1.0.0

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WEBSOCKET_URL=http://localhost:5000
VITE_WEBSOCKET_RECONNECTION_DELAY=1000
VITE_WEBSOCKET_RECONNECTION_DELAY_MAX=5000

# Authentication
VITE_JWT_TOKEN_KEY=biocare_token
VITE_JWT_REFRESH_KEY=biocare_refresh_token

# Environment
VITE_NODE_ENV=development
VITE_DEBUG_MODE=true

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_ANALYTICS=false

# App Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_NOTIFICATION_TIMEOUT=5000
VITE_ITEMS_PER_PAGE=10
